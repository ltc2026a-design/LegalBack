# Copiame como .env en la raiz del proyecto (esta ignorado por git).
# En Render NO hace falta: las variables se configuran en el panel o en render.yaml.

# ---- Servidor ----
PORT=3000
# En Render se deja en blanco (escucha el puerto que le asigna la plataforma).
HOST=127.0.0.1
# Detras de un proxy reverso (Render, Railway, Fly): activa confiar en X-Forwarded-For.
# Sin esto, el limitador por IP ve una sola IP y bloquea a todo el mundo.
TRUST_PROXY=1
# Version que devuelve GET /api/health (opcional).
VERSION_DEPLOY=1.0.0

# ---- Base de datos ----
# Local (embedded):   postgresql://postgres:postgres@127.0.0.1:5544/legal
# Produccion (Supabase): pooler de sesion, usuario postgres.<ref> y sslmode=no-verify.
#   El driver pg trata `require` como verify-full y el certificado del pooler no pasa.
#   Nada de pooler de transacciones (6543): pgbouncer rompe las migraciones de Prisma.
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST:5432/nombre_bd?sslmode=no-verify
# Solo para `npm run db` en Windows: carpeta de datos SIN espacios en la ruta.
PGDATA_DIR=C:/legal-pgdata
# Tamano del pool de Prisma/pg (Render free recomienda dejarlo bajo).
PG_POOL_MAX=10

# ---- Autenticacion ----
# Obligatoria en produccion. Genera una:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES=8h

# ---- CORS ----
# Origenes que pueden llamar la API, separados por coma. Acepta * como comodin.
ORIGINES_PERMITIDAS=https://*.vercel.app,https://TU-DOMINIO.vercel.app

# ---- Notificaciones Web Push (VAPID) ----
# npm run gen:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:correo@dominio.com

# ---- Asistente con IA (opcional) ----
# Sin llave, el chat degrada a "Busqueda guiada" (funciona igual).
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODELO=gemini-2.5-flash
